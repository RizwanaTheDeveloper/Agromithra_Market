DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/agromitra_market?schema=public"
PORT=5000
# Browser origins allowed to call the API: Expo web, the frontend dev server (npm run web), and the native WebView shell.
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:4173,https://agromitra.local
NODE_ENV=development
# Development mode returns the generated OTP in the response. Disabled in production.
OTP_MODE=development
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# Production sign-in: set OTP_MODE=sms and Twilio credentials (OTP codes are then sent by SMS, never returned by the API).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...            (or TWILIO_MESSAGING_SERVICE_SID=MG...)
# Comma separated numbers that become administrators when they sign in (can approve buyers).
ADMIN_PHONES=
# Requests per minute per client address (default 300). Behind a proxy/load balancer set TRUST_PROXY=1.
# THROTTLE_LIMIT=300
# TRUST_PROXY=1

# Folder for uploaded photos/videos (default: backend/uploads). Back it up with the database; in Docker mount it as a volume.
# UPLOAD_DIR=C:/Agromitra/uploads
