{
  "name": "agromitra-market-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "studio": "prisma studio --schema prisma/schema.prisma",
    "db:status": "node scripts/db-status.cjs",
    "prisma:migrate": "prisma migrate dev",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:integration": "npm run build && node --test test/api.integration.cjs",
    "prisma:deploy": "prisma migrate deploy",
    "media:move": "node scripts/move-media-to-disk.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.2"
  }
}
