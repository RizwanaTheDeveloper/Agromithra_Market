# Copy to .env to connect the app to the backend. Leave unset (or empty) for the offline demo.
# Android emulator: http://10.0.2.2:5000/api/v1   Phone on your Wi-Fi: http://<PC-LAN-IP>:5000/api/v1
# Production must use https://.
MARKET_API_URL=http://localhost:5000/api/v1
# local uses src/data/marketplace.json and device storage; server uses the backend API.
MARKET_DATA_SOURCE=server
